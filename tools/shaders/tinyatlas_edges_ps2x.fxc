// Tiny Atlas: the pixel-art look's outlines (cl_view.lua draws it over the whole small picture, stretched to the
// screen with sharp pixels). Dark where something stands in front of something farther away, found from each pixel's
// distance (the stock DepthWrite shader's colour depth). tools/gmodcheck/ride.html does the same for the pictures.
// Built with SCell555's ShaderCompile (tools/shaders/build.sh) into shaders/fxc/tinyatlas_edges_ps20b.vcs.
//   s0  the picture (small render target)          s1  the distance at every pixel (0: nothing there)
//   c0  x, y = one pixel in texture coordinates; z = how much farther the neighbour must be than the surface going on
//       (share); w = how much darker an outline pixel is

#include "common_ps_fxc.h"

sampler PictureSampler : register( s0 );
sampler DepthSampler   : register( s1 );
const float4 g_Params  : register( c0 );

struct PS_INPUT
{
	float2 uv : TEXCOORD0;
};

// 1 / distance: linear across a flat surface on the screen (0: nothing there)
float InvDepth( float2 uv )
{
	float d = tex2D( DepthSampler, uv ).r;
	return d > 0.0 ? 1.0 / d : 0.0;
}

float4 main( PS_INPUT i ) : COLOR
{
	float3 col = tex2D( PictureSampler, i.uv ).rgb;
	float w = InvDepth( i.uv );
	if ( w > 0.0 )
	{
		float s = g_Params.z;
		float2 px = g_Params.xy;
		float2 dirs[4] = { float2( px.x, 0.0 ), float2( -px.x, 0.0 ), float2( 0.0, px.y ), float2( 0.0, -px.y ) };
		float edge = 0.0;
		for ( int k = 0; k < 4; k++ )
		{
			float wa = InvDepth( i.uv + dirs[k] );
			float wb = InvDepth( i.uv - dirs[k] );
			float pred = 2.0 * w - wb;           // where the neighbour would be if the surface went on flat
			if ( wa < pred * ( 1.0 - s ) && wa < w * ( 1.0 - s * 0.5 ) ) edge = 1.0;
		}
		col *= 1.0 - edge * g_Params.w;
	}
	return float4( col, 1.0 );
}
